    "author": "vasic-digital",
    "app": "HelixCode",
    "version": "1.0.0",
    "tracked_item": "HXC-029",
    "covenant": "\u00a711.4.98 full-automation anti-bluff",
    "target_server": "HelixCode HTTP server (cmd/server) \u2014 real PostgreSQL + Redis backed",
    "origin_note": "Authored for HXC-029 because helix_qa/banks/full-qa-api.json targets the Catalogizer catalog-api (metadata.app=Catalogizer), whose endpoints (/api/v1/entities, /api/v1/collections, session_token login) do NOT exist on HelixCode. This bank targets HelixCode's real route table (internal/server/server.go)."
  },
