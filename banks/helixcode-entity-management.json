{
  "version": "1.0",
  "name": "HelixCode Entity Management - API",
  "description": "Self-driving (§11.4.98) HelixQA bank exercising HelixCode's REAL entity-CRUD HTTP surface (tasks, projects, sessions, workers, users) at the configured base URL. HelixCode's true 'entities' are these domain objects (internal/server/server.go route table), NOT the Catalogizer entities/collections the original entity-management.json bank targeted — those return 404 here and are honest _skip, never a fabricated PASS. Every executable step is a real http:+assert request: list/get/create/update/delete on each entity group without auth must be rejected (401), unknown ids and routes 404, OPTIONS 204. Read-only / negative paths only — self-cleaning (no state created, nothing to clean up).",
  "metadata": {
    "author": "vasic-digital",
    "app": "HelixCode",
    "version": "1.0.0",
    "tracked_item": "HXC-029",
    "covenant": "§11.4.98 full-automation anti-bluff",
    "target_server": "HelixCode HTTP server (cmd/server) — real PostgreSQL + Redis backed",
    "origin_note": "Authored for HXC-029. The original helix_qa/banks/entity-management.json (metadata.app=Catalogizer) drives /api/v1/entities + /api/v1/collections + parent_id/season episode hierarchy, none of which exist on HelixCode (probed 404). This bank targets HelixCode's real entity CRUD groups discovered by live probing + internal/server/server.go. Catalogizer-only entity hierarchy steps are honest _skip."
  },
  "test_cases": [
    {
      "id": "HXC-ENT-001",
      "name": "List tasks entity-collection without auth is rejected",
      "category": "functional",
      "priority": "critical",
      "platforms": ["api"],
      "steps": [
        {
          "name": "GET /api/v1/tasks no auth",
          "action": "http: GET /api/v1/tasks",
          "expected": "401 Authorization header required",
          "expect_status": 401,
          "expect_json_path": "$.message",
          "expect_body_contains": "Authorization header required"
        }
      ],
      "tags": ["entity", "tasks", "authz"],
      "estimated_duration": "5s",
      "expected_result": "Task entity listing is auth-gated (401 without token)"
    },
